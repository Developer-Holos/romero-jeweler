{
	"name": "jeweler",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"test:api": "node --test src/lib/server/widget/*.test.ts",
		"widget:build": "vite build -c vite.widget.config.ts",
		"widget:zip": "vite build -c vite.widget.config.ts && node widget/empaquetar.mjs",
		"widget:tour": "vite build -c vite.widget.config.ts && node widget/_tour_src/tour.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/pg": "^8.23.1",
		"@vitest/browser-playwright": "^4.1.8",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@electric-sql/pglite": "^0.5.13",
		"openai": "^7.45.1",
		"pg": "^8.23.1",
		"playwright": "1.64.1"
	}
}
