# Copia este archivo como .env y completa los valores. En Railway van como variables del servicio.

# Kommo (cuenta romerojeweler): la página de tracking lee los leads; la API del widget sube el PDF y las imágenes.
KOMMO_SUBDOMAIN=romerojeweler
KOMMO_ACCESS_TOKEN=
# Id del campo "Invoice" (archivo, pestaña Orden). Solo de respaldo: el widget le pasa el id a la API.
KOMMO_CAMPO_INVOICE=288076

# API del widget (/api). Opcional: si se define, el widget debe mandarla (ajuste "Clave del widget" en Kommo).
WIDGET_KEY=
# Clave solo para Holos: cambiar el modelo de IA sin redesplegar (PUT /api/admin/ia, header X-Admin-Key).
ADMIN_KEY=
# Orígenes que pueden llamar a /api, separados por coma.
ORIGENES=https://romerojeweler.kommo.com

# Postgres (Railway la inyecta al agregar la base al proyecto). Sin ella se usa PGlite en DATA_DIR.
DATABASE_URL=
DATA_DIR=data

# OpenAI (cuenta de Holos). Sin clave, el invoice sale con el texto estándar.
OPENAI_API_KEY=
# Modelo inicial; después se cambia con PUT /api/admin/ia y queda guardado en la base.
OPENAI_MODEL=gpt-5-mini

# Video del cliente en Dropbox (/api/videos). Sin las tres credenciales, la sección queda apagada.
# App del App Console con acceso Full Dropbox y scopes files.metadata.read + sharing.write (ver README).
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
# Carpeta que contiene las carpetas de las órdenes (p. ej. /Romero/Ordenes). Vacía: se buscan por nombre.
DROPBOX_RAIZ=
# Id del Salesbot que manda el link del video al cliente y marca "Video enviado". Sin él, solo link + nota.
KOMMO_BOT_VIDEO=

# adapter-node: los PDF llegan como HTML con las imágenes adentro.
BODY_SIZE_LIMIT=25M

# Seguimientos con IA: clave que va en la URL de los webhooks de Kommo (?clave=…). Sin ella, quedan apagados.
KOMMO_WEBHOOK_KEY=
# Opcionales (valores por defecto): campo "[V] Mensaje Seguimiento" y Salesbot que lo envía.
KOMMO_CAMPO_SEGUIMIENTO=463316
KOMMO_BOT_SEGUIMIENTO=10394
