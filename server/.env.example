# Copia este archivo como .env y completa los valores.
PORT=8787
# Clave que comparte con el widget (header Authorization: Bearer ...). Genera una larga y al azar.
WIDGET_API_KEY=
# Orígenes que pueden llamar al servidor, separados por coma.
ORIGENES=https://romerojeweler.kommo.com,http://localhost:5173,http://localhost:4173
# Sin clave el servidor funciona, pero /ia/redactar responde 503.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Carpeta donde se guarda la plantilla de diseño.
DATA_DIR=data
