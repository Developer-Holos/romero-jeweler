# Copia este archivo como .env y completa los valores. En Railway van como variables del servicio.
PORT=8787
# Opcional. Si se define, el widget debe mandarla (ajuste "Clave del widget" en Kommo; header X-Widget-Key).
# Sin ella, basta con la URL del servidor.
WIDGET_KEY=
# Clave solo para Holos: cambiar el modelo de IA sin redesplegar (PUT /admin/ia, header X-Admin-Key).
ADMIN_KEY=
# Orígenes que pueden llamar al servidor, separados por coma.
ORIGENES=https://romerojeweler.kommo.com,http://localhost:5173,http://localhost:4173

# Postgres (Railway la inyecta al agregar la base al proyecto). Sin ella se usa PGlite en DATA_DIR.
DATABASE_URL=
DATA_DIR=data

# OpenAI (cuenta de Holos). Sin clave, el invoice sale con el texto estándar.
OPENAI_API_KEY=
# Modelo inicial; después se cambia con PUT /admin/ia y queda guardado en la base.
OPENAI_MODEL=gpt-5-mini

# Kommo: guardar el PDF en el campo "Invoice" del lead y las imágenes como archivos del lead.
KOMMO_SUBDOMAIN=romerojeweler
KOMMO_ACCESS_TOKEN=
# Id del campo "Invoice" (tipo archivo) de los leads. Sin él, el PDF solo se descarga.
# En la cuenta romerojeweler es 133486.
KOMMO_CAMPO_INVOICE=133486
